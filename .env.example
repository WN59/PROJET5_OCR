# Copier vers .env et adapter si besoin (ne jamais committer .env)

MYSQL_DATABASE=mdd
MYSQL_USER=mdd
MYSQL_PASSWORD=mdd_secret
MYSQL_ROOT_PASSWORD=root_secret
MYSQL_PORT=3306
PHPMYADMIN_PORT=8081

# Spring Boot (profil local)
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/mdd?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=mdd
SPRING_DATASOURCE_PASSWORD=mdd_secret
